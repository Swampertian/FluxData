<div class="action-bar">
    <div class="action-bar__left">
        @LeftContent
    </div>
    <div class="action-bar__right">
        @RightContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? LeftContent { get; set; }
    [Parameter] public RenderFragment? RightContent { get; set; }
}
