<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmEnableThreads>false</WasmEnableThreads>
    <RunAOTCompilation>true</RunAOTCompilation>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
    <PackageReference Include="Z.Blazor.Diagrams" Version="3.0.4.1" />
  </ItemGroup>

</Project>
